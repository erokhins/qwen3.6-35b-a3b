# --- Checkpoints: models/<modelname>/ are downloads, never committed ---
# 66.97 GiB of safetensors here; never in git, never in a diff, never in a log line.
models/
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.onnx
*.msgpack
*.npy
*.npz
*.h5
*.ggml

# --- Cloned reference engines (external read-only checkouts) ---
engines/

# --- Reference dumps / fixtures / bench output (regenerable) ---
data/
logs/
tmp/

# --- Local python envs (the CPU oracle venv; W4 may create ./.venv) ---
.venv/

# --- Agent scratch / IDE state ---
.pi/
.junie/
.idea/
.vscode/
__pycache__/
*.pyc

# --- Build output ---
build/
build-*/
CMakeCache.txt
CMakeFiles/
compile_commands.json
*.o
*.so
*.hipfb
*.hipi
*.bc
*.out
*.out.resolution.txt
*.aout.bin

# --- A built prototype binary is ignored by EXACT path, never by directory. ---
# The sibling repo's lesson (`prototype/**/<op>` matched the op DIRECTORY, so the
# whole prototype/<op>/ went untracked): list binaries as `prototype/<op>/<op>`.
# Check `git status --ignored` after adding an op.
prototype/q4k_dequant/q4k_dequant
prototype/q4k_dequant/host_probe
prototype/q4k_dequant/work/
prototype/moe_router/moe_router
prototype/moe_router/host_probe
# Scratch, except the files results.md cites as evidence: an ignored directory means a fresh clone has
# the conclusion and not the proof, which is what bit the prediction-3 corrigendum (2026-10-26). Un-ignore
# the directory with /* so individual exceptions work, then re-admit exactly the cited probes.
prototype/moe_router/work/*
!prototype/moe_router/work/probe9.py
!prototype/moe_router/work/probe15.py
!prototype/moe_router/work/verify_p3_offset.py
# prototype/moe_gather compiled artefacts -- exact paths only, never the directory: the directory
# must stay visible so an empty evidence/ cannot hide a lane that produced nothing (2026-10-26).
prototype/moe_gather/moe_gather
prototype/moe_gather/host_probe
prototype/moe_gather/build/moe_gather.o
prototype/moe_gather/work/host_probe_selftest
# Generated gate work for moe_gather: exact-path ignore of the directory contents (never the
# directory, so an empty lane cannot hide), with the proof files results.md cites re-admitted — the
# prediction-3 corrigendum is worth nothing to a fresh clone if oracle_p3.tsv is untracked.
prototype/moe_gather/work/*
!prototype/moe_gather/work/oracle_p3.tsv
!prototype/moe_gather/work/oracle_p3_matrix.tsv
!prototype/moe_gather/work/oracle_floor.tsv
!prototype/moe_gather/work/cases.tsv
!prototype/moe_gather/work/plan.tsv
!prototype/moe_gather/work/diag_span.py
!prototype/moe_gather/work/diag_x.py
!prototype/moe_gather/work/probe9.py
